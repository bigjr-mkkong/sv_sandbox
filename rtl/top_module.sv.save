module top_module#(
    parameter DATAW = 32,
    parameter ERRW = 2
    ) (
    input   logic clk_i,
    input   logic rst_ni,

    input   logic req_val,
    input   logic req_com, //0 enq, 1 deq
    input   logic [DATAW-1: 0]req_data,
    output  logic req_rdy,

    output  logic rsp_val,
    output  logic [ERRW-1: 0]rsp_state, //0 normal, 1 empty, 2 full
    output  logic [DATAW-1: 0]rsp_data,
    input   logic rsp_rdy
);

/*
* recv |-> read/write |-> send
*/

logic [DATAW-1: 0] recv_rw_data_q, recv_rw_data_d;
logic recv_rw_com_q, recv_rw_com_d;

logic recv_rw_val_q, recv_rw_val_d;
logic recv_rw_rdy_q, recv_rw_rdy_d;

logic [DATAW-1: 0] rw_send_data_q, rw_send_data_d;
logic [ERRW-1: 0] rw_send_state_q, rw_send_state_d;

logic rw_send_val_q, rw_send_val_d;
logic rw_send_rdy_q, rw_send_rdy_d;


logic [DATAW-1: 0] rw_data_out;
logic [ERRW-1] rw_state_out;

always @(posged clk_i) begin
    if (~rst_ni) begin
        recv_rw_data_q <= 0;
        recv_rw_com_q <= 0;
        rw_send_data_q <= 0;
        rw_send_state_q <= 0;
        recv_rw_rdy_q <= 1;
        rw_send_rdy_q <= 1;
        recv_rw_val_q <= 0;
        rw_send_val_q <= 0;
    end else begin
        recv_rw_data_q <= recv_rw_data_d;
        recv_rw_com_q <= recv_rw_com_d;
        rw_send_data_q <= rw_data_out;
        rw_send_state_q <= rw_state_out;
        recv_rw_rdy_q <= recv_rw_rdy_d;
        rw_send_rdy_q <= rw_send_rdy_d;
        recv_rw_val_q <= recv_rw_val_d;
        rw_send_val_q <= rw_send_val_d;
    end
end

//recv stage
always_comb begin
    if (req_val && recv_rw_rdy_q) begin
        recv_rw_data_d = req_data;
        recv_rw_com_d = req_com;
        recv_rw_val_d = 1;
    end else begin
        recv_rw_data_d = 0;
        recv_rw_com_d = 0;
        recv_rw_val_d = 0;
    end
end

//rw stage
always_comb begin
    if (recv_rw_val_q) begin
        recv_rw_rdy_d = 1;
        rw_send_val_d = 1;
    end else begin
        recv_rw_rdy_d = 0;
        rw_send_val_d = 0;
    end
    //then write to rw_data_out and rw_state_out
end

//send stage
always_comb begin
    if (rsp_rdy && rw_send_val_q) begin
        rsp_val = 1;
        rsp_state = rw_send_state_q;
        rsp_data = rw_send_data_q;
        rw_send_rdy_d = 1;
    end else begin
        rsp_val = 0;
        rsp_state = 0;
        rsp_data = 0;
        rw_send_rdy_d = 0;
    end
end

endmodule

module ptr_gen#(
    parameter PTR_WID = 4
    )(
    input   logic [PTR_WID-1: 0] old_ptr,
    output  logic [PTR_WID-1: 0] new_ptr,
)

    assign new_ptr =  old_ptr + PTR_WID'd1;

endmodule

module fifo #(
    parameter DATAW = 32,
    parameter FIFO_SZ = 16,
    parameter FIFO_ADDRW = 4,
    parameter ERRW = 2
    ) (
    input   logic clk_i,
    input   logic rst_ni,

    input   logic [DATAW-1: 0] data_i,
    input   logic cmd_i, //0 enq, 1 deq

    output  logic [DATAW-1: 0] data_o,
    output  logic [ERRW-1: 0] state_o//0 normal, 1 empty, 2 full
)

logic [FIFO_ADDRW-1: 0] rptr_d, rptr_q, rptr_buf;
logic [FIFO_ADDRW-1: 0] wptr_d, wptr_q, wptr_buf;
logic [FIFO_ADDRW-1: 0] cnt_d, cnt_q;

logic [ERRW-1:0] state_out;

always @(posedge clk_i) begin
    if (~rst_ni) begin
        rptr_q <= 0;
        wptr_q <= 0;
        cnt_q <= 0;
    end else begin
        rptr_q <= rptr_d;
        wptr_q <= wptr_d;
        cnt_q <= cnt_d;
    end
end

assign cnt_d = cnt_q + ((cmd_i)?-1:1);

ptr_adder(
    .old_ptr(wptr_q),
    .new_ptr(wptr_buf),
    ):
assign wptr_d = (~cmd_i)?wptr_buf:wptr_q;

ptr_adder(
    .old_ptr(rptr_q),
    .new_ptr(rptr_buf)
    ):
assign rptr_d = (cmd_i)?rptr_buf:rptr_q;

always_comb begin
    if (rptr_q == wptr_q) begin
        if (cnt_q == 0) begin
            state_out = (cmd_i)?1:0;
        end else if (cnt_q == FIFO_SZ) begin
            state_out = (~cmd_i)?2:0;
        end else begin
            state_out = 3;
        end
    end else begin
        state_out = 0;
    end
end

assign state_o = state_out;

assign data_o = 1;

endmodule

module memory #(
    parameter MEM_SZ = 16,
    parameter DATAW = 32,
    parameter ADDRW = $clog2(MEM_SZ)
    ) (
    input   logic clk_i,
    input   logic rst_ni,

    input   logic req_val_i,
    input   logic req_rw_i,//0 read, 1 write
    input   logic [DATAW-1: 0]data_i,
    input   logic [ADDRW-1: 0]addr_i,
    output  logic req_rdy_o,

    output  logic rsp_val_o,
    output  logic [DATAW-1: 0]data_o,
    input   logic rsp_rdy_i
    )

logic[MEM_SZ-1: 0] mem[DATAW-1: 0];

logic req_rw_buf_q, req_rw_buf_d;
logic [DATAW-1: 0]req_data_buf_q, req_data_buf_d;
logic [ADDRW-1: 0]addr_buf_q, addr_buf_d

    always @(posedge clk_i) begin
        if (~rst_ni) begin

        end else begin

        end
    end

endmodule
